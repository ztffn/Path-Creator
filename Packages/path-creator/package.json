{
  "name": "@huma/path-creator",
  "version": "0.2.0",
  "description": "Path creator runtime for Three.js and React Three Fiber",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "require": "./dist/three/index.cjs"
    },
    "./r3f": {
      "types": "./dist/r3f/index.d.ts",
      "import": "./dist/r3f/index.js",
      "require": "./dist/r3f/index.cjs"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "import": "./dist/timeline/index.js",
      "require": "./dist/timeline/index.cjs"
    },
    "./timeline-ui": {
      "types": "./dist/timeline-ui/index.d.ts",
      "import": "./dist/timeline-ui/index.js",
      "require": "./dist/timeline-ui/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/timeline-ui/index.js",
    "./dist/timeline-ui/index.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@xzdarcy/react-timeline-editor": "^1.0.0",
    "@xzdarcy/timeline-engine": "1.0.0"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": ">=0.181.0 <0.190.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.0.0",
    "@types/react": "^19.1.13",
    "@types/three": "^0.181.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
