{
  "name": "@huma/pascal-time",
  "version": "0.1.0",
  "private": true,
  "description": "Time as a Pascal plugin — node kinds, object binding and track driving over a Pascal scene",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
