      "types": "./dist/host-panel/index.d.ts",
      "import": "./dist/host-panel/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@huma/path-creator": "workspace:*",
    "@pascal-app/core": "1.0.0-beta.4",
    "@pascal-app/editor": "1.0.0-beta.4",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.185.0 <0.190.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@pascal-app/editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huma/path-creator": "workspace:*",
    "@pascal-app/core": "1.0.0-beta.4",
    "@pascal-app/editor": "1.0.0-beta.4",
    "@react-three/drei": "^10.7.6",
    "next": "16.3.1",
    "@react-three/fiber": "^9.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.3.5",
    "zustand": "^5.0.0"
  }
